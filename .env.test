# Test environment — committed on purpose, contains NO real secrets.
# Used by `npm test` (Vitest) and `npm run test:server` (e2e BE for the web app).
# TURSO_URL MUST be a local file: URL — test/test-env.mjs refuses anything else.
TURSO_URL=file:./test/.tmp/e2e.db
JWT_SECRET=test-only-secret-not-used-anywhere-else
PORT=3101
APP_URL=http://localhost:3101
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174
