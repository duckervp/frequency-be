{
    "name": "frequency-be",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "node --env-file=.env --import tsx/esm --watch src/server.ts",
        "build": "tsc -b",
        "start": "node dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:migrate": "drizzle-kit migrate",
        "db:baseline": "node --env-file=.env --import tsx/esm src/db/baseline.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:db:reset": "node --env-file=.env.test --import tsx/esm test/reset-db.ts",
        "test:server": "npm run test:db:reset && node --env-file=.env.test --import ./test/test-env.mjs --import tsx/esm src/server.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.9",
        "@libsql/client": "^0.17.0",
        "bcryptjs": "^3.0.3",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.12.2",
        "jose": "^6.1.3",
        "nanoid": "^5.1.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^24.10.1",
        "drizzle-kit": "^0.31.9",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.7"
    }
}
